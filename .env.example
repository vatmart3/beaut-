# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://brume-institut.vercel.app

# Envoi des e-mails (réservations, bons cadeaux, contact) via Resend.
# Sans clé : mode démo — les demandes sont journalisées côté serveur et le formulaire affiche un succès.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "BRUME <bonjour@votre-domaine.fr>"
MAIL_FROM=
# Adresse qui reçoit les demandes (par défaut : l'e-mail de src/config/site.ts)
MAIL_TO=
